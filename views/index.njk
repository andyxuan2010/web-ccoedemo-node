{% extends "base.njk" %}

{% block title %}Home | AAD SSO Demo{% endblock %}

{% block content %}
<span class="section-kicker" data-i18n="home.kicker">Identity Demo</span>
<h1 data-i18n="home.title">Node.js demo with MS Entra ID SSO</h1>
<p data-i18n="home.intro">
    This sample supports two sign-in modes on one site: Express/MSAL (app-managed) and
    App Service Easy Auth (platform-managed).
</p>

<div class="mode-grid">
    <div class="mode-option">
        <div class="mode-card msal">
            <h3 data-i18n="home.msal.title">MSAL Mode</h3>
            <p data-i18n="home.msal.copy">The Express app uses MSAL to initiate sign-in, process the authorization response, acquire tokens, and maintain the authenticated user session in application code.</p>
            <div class="mode-diagram">
                <img src="{{ static_url('img/msal-flow.svg', cache_token) }}" alt="MSAL authentication flow diagram">
            </div>
        </div>
        <a class="button primary mode-signin-button" href="{{ path_for('login_msal') }}" data-i18n="home.signin.msal">Sign in with MSAL</a>
    </div>
    <div class="mode-option">
        <div class="mode-card easy-auth">
            <h3 data-i18n="home.easy.title">Easy Auth Mode</h3>
            <p data-i18n="home.easy.copy">Azure App Service authenticates the user before the request reaches Express, then provides verified identity details through platform-managed headers.</p>
            <div class="mode-diagram">
                <img src="{{ static_url('img/easy-auth-flow.svg', cache_token) }}" alt="Easy Auth authentication flow diagram">
            </div>
        </div>
        <a class="button secondary mode-signin-button" href="{{ path_for('login_easyauth') }}" data-i18n="home.signin.easy">Sign in with Easy Auth</a>
    </div>
</div>

{% if msal_user %}
<p>
    MSAL session active for
    <strong>{{ msal_user.get("name") or msal_user.get("preferred_username") }}</strong>.
</p>
<div class="actions">
    <a class="button primary" href="{{ path_for('profile_msal') }}">View MSAL profile</a>
    <a class="button secondary" href="{{ path_for('logout_msal') }}">Sign out (MSAL)</a>
</div>
{% endif %}

{% if easy_auth_user %}
<p>
    Easy Auth session active for
    <strong>{{ easy_auth_user.get("name") or easy_auth_user.get("preferred_username") }}</strong>.
</p>
<div class="actions">
    <a class="button primary" href="{{ path_for('profile_easyauth') }}">View Easy Auth profile</a>
    <a class="button secondary" href="{{ path_for('logout_easyauth') }}">Sign out (Easy Auth)</a>
</div>
{% endif %}

{% if not msal_user and not easy_auth_user %}
<p>
    <span data-i18n="home.choose">Choose an authentication mode to start sign-in.</span>
</p>
{% endif %}
{% endblock %}
